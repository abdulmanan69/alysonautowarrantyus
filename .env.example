# Local development settings. For production see docker-compose.yml and DEPLOY.md.

# PostgreSQL started by `npm run db:up` (docker-compose.dev.yml).
DATABASE_URL="postgresql://alyson:alyson_dev@localhost:5432/alyson?schema=public"

# Public address of the site (production: your https domain, e.g. https://alysonautowarrantyus.com).
SITE_URL="http://localhost:3000"

# Admin login (/admin). The first sign-in creates the owner account from these. CHANGE THEM.
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me-now"

# Signs share-image URLs (/api/og). Use a long random value, e.g. `openssl rand -base64 32`.
OG_SECRET="change-me"

# Optional alerts for new quote requests and messages (recipients are set in /admin/settings).
# Email via Resend (https://resend.com): API key + a verified sender address.
RESEND_API_KEY=""
NOTIFY_FROM="Alyson Auto Warranty <alerts@alysonautowarrantyus.com>"
# Text messages via Twilio.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Set to "true" after adding your TrustedForm snippet (see src/components/TrustedForm.tsx). Build-time.
NEXT_PUBLIC_TRUSTEDFORM_ENABLED="false"
