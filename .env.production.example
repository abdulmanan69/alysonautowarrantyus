# Production without Coolify: copy to .env, fill in every value, then `docker compose up -d --build`.
# With Coolify you don't need this file: it fills in the SERVICE_* values itself (see DEPLOY.md).

# Public https address of the site, no trailing slash.
SITE_URL=https://alysonautowarrantyus.com

# Database credentials used by the db, app and backup services.
SERVICE_USER_POSTGRES=alyson
SERVICE_PASSWORD_POSTGRES=
POSTGRES_DB=alyson

# First sign-in to /admin creates the owner account from these. Use a long password.
ADMIN_USER=admin
SERVICE_PASSWORD_ADMIN=

# Long random string that signs share-image links, e.g. `openssl rand -hex 32`.
SERVICE_PASSWORD_64_OGSECRET=

# Optional alerts (recipients are set in /admin/settings).
RESEND_API_KEY=
NOTIFY_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional: TrustedForm consent certificates (needs a rebuild to change).
NEXT_PUBLIC_TRUSTEDFORM_ENABLED=false

# Backups
BACKUP_KEEP_DAYS=14
BACKUP_EVERY_HOURS=24
